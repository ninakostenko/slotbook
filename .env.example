# Copy to .env and fill in. Never commit .env.

# Neon: pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Protects the daily demo reset route
CRON_SECRET=

# The demo owner's password. Pick any long random value; use the SAME one locally and on Vercel.
DEMO_PASSWORD=
